{
  "name": "gleap-admin",
  "version": "1.1.0",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --project ./tsconfig-typecheck.json",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest --forceExit",
    "prebuild": "npm run typecheck && npm run lint && npm test",
    "build": "npm run clean && tsc --project ./tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "homepage": "https://github.com/GleapSDK/GleapAdmin-NodeJS",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/"
  ],
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.10",
    "eslint": "^9.9.0",
    "globals": "^15.9.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0"
  }
}
