{
  "permissions": {
    "deny": [
      "Read(**/.env*)",
      "Bash(cat .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(npm publish*)",
      "Bash(npm unpublish*)",
      "Bash(npm deprecate*)",
      "Bash(npm dist-tag*)",
      "Bash(npm version*)",
      "Bash(npm login*)",
      "Bash(npm token*)",
      "Bash(node demo.js*)",
      "Bash(node examples/*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-edited-file.mjs",
            "timeout": 30,
            "statusMessage": "Quality check and ESLint on the edited file..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-before-stop.mjs",
            "timeout": 300,
            "statusMessage": "Quality check, typecheck and tests..."
          }
        ]
      }
    ]
  }
}
