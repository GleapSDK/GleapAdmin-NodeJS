{
  "keywords": [
    "gleap",
    "nodejs",
    "sdk",
    "customer-support",
    "customer-data",
    "event-tracking"
  ],
  "description": "Node.js admin SDK for Gleap: identify customers, track server-side events and update companies for customer support and feedback workflows.",
  "name": "gleap-admin",
  "version": "1.3.0",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepare": "sh .githooks/install.sh 2>/dev/null || exit 0",
    "typecheck": "tsc --project ./tsconfig-typecheck.json",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "node scripts/test/run.mjs",
    "test:coverage": "node scripts/test/run.mjs --coverage",
    "test:quality": "node --test tools/quality/check.test.mjs",
    "quality": "node tools/quality/check.mjs --base origin/main",
    "prebuild": "npm run typecheck && npm run lint && npm test",
    "build": "npm run clean && tsc --project ./tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "homepage": "https://github.com/GleapSDK/GleapAdmin-NodeJS",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/"
  ],
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^20.14.10",
    "eslint": "^9.9.0",
    "globals": "^15.9.0",
    "prettier": "^3.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0"
  }
}
